}

// ============================================================
// FIGURA 2: DIAGRAMA DE NIVELES Y SIEGBAHN
// ============================================================
const ATOMIC_SHELLS = {
  29: { name: 'Cobre (Cu)', Z: 29, K: -8.979, L: -0.930, M: -0.074, N: -0.008 },
  42: { name: 'Molibdeno (Mo)', Z: 42, K: -20.000, L: -2.520, M: -0.400, N: -0.050 },
  47: { name: 'Plata (Ag)', Z: 47, K: -25.514, L: -3.351, M: -0.570, N: -0.075 },
  74: { name: 'Wolframio (W)', Z: 74, K: -69.525, L: -10.207, M: -2.281, N: -0.435 }
};

function drawFig2() {
  const zVal = parseInt(document.getElementById('sel_elem_levels').value);
  const lineKey = document.getElementById('sel_xray_line').value;
  const el = ATOMIC_SHELLS[zVal];

  const levels = [
    { name: 'K (n = 1)', energy: el.K },
    { name: 'L (n = 2)', energy: el.L },
    { name: 'M (n = 3)', energy: el.M },
    { name: 'N (n = 4)', energy: el.N }
  ];

  const traces = [];

  // Dibujar barras de niveles
  levels.forEach(lv => {
    traces.push({
      x: [0.1, 0.9], y: [lv.energy, lv.energy],
      type: 'scatter', mode: 'lines',
      line: { color: '#2c3e50', width: 2.5 },
      showlegend: false, hoverinfo: 'skip'
    });
    traces.push({
      x: [0.93], y: [lv.energy],
      type: 'scatter', mode: 'text',
      text: [`${lv.name}: ${lv.energy.toFixed(3)} keV`],
      textposition: 'middle right',
      textfont: { size: 11, color: '#2c3e50', family: 'Segoe UI' },
      showlegend: false, hoverinfo: 'skip'
    });
  });

  let eInit = 0, eFinal = 0, nameTrans = '', initName = '', finalName = '';
  if (lineKey === 'Ka') {
    eInit = el.L; eFinal = el.K; nameTrans = 'K_α (L → K)'; initName = 'L (n=2)'; finalName = 'K (n=1)';
  } else if (lineKey === 'Kb') {
    eInit = el.M; eFinal = el.K; nameTrans = 'K_β (M → K)'; initName = 'M (n=3)'; finalName = 'K (n=1)';
  } else if (lineKey === 'La') {
    eInit = el.M; eFinal = el.L; nameTrans = 'L_α (M → L)'; initName = 'M (n=3)'; finalName = 'L (n=2)';
  } else if (lineKey === 'Lb') {
    eInit = el.N; eFinal = el.L; nameTrans = 'L_β (N → L)'; initName = 'N (n=4)'; finalName = 'L (n=2)';
  }

  const deltaE_keV = Math.abs(eInit - eFinal);
  const lambda_nm = PHYS.hc_eV_nm / (deltaE_keV * 1000);

  // Flecha de la transición
  traces.push({
    x: [0.45, 0.45], y: [eInit, eFinal],
    type: 'scatter', mode: 'lines+markers',
    name: `Transición ${nameTrans}`,
    line: { color: '#c0392b', width: 3.5 },
    marker: { color: '#c0392b', size: 9, symbol: ['circle', 'arrow'] },
    hovertemplate: `Transición ${nameTrans}<br>ΔE = ${deltaE_keV.toFixed(3)} keV<br>λ = ${lambda_nm.toFixed(4)} nm<extra></extra>`
  });

  const yMinPlot = el.K * 1.15;
  const yMaxPlot = 3.0;

  Plotly.react('plot_energy_levels', traces, {
    xaxis: { range: [0, 1.45], showticklabels: false, zeroline: false, showgrid: false },
    yaxis: { title: 'Energía de ligadura (keV)', range: [yMinPlot, yMaxPlot], zeroline: true, zerolinecolor: '#aaa' },
    margin: { l: 65, r: 25, t: 20, b: 40 },
    legend: { x: 0.02, y: 0.98, bgcolor: 'rgba(255,255,255,0.9)', font: { size: 11 } },
    plot_bgcolor: '#fafafa'
  }, { responsive: true, displayModeBar: false });

  document.getElementById('stats_levels').innerHTML =
    `<span class="stat-item"><span class="lbl">Elemento:</span> <span class="val">${el.name}</span></span>` +
    `<span class="stat-item"><span class="lbl">Línea:</span> <span class="val">${nameTrans}</span></span>` +
    `<br><span class="stat-item"><span class="lbl">Energía fotón ΔE:</span> <span class="val">${deltaE_keV.toFixed(3)} keV</span></span>` +
    `<span class="stat-item"><span class="lbl">Longitud de onda λ:</span> <span class="val">${lambda_nm.toFixed(4)} nm (${(lambda_nm * 10).toFixed(2)} Å)</span></span>`;
}

// ============================================================
// FIGURA 3: LA GRÁFICA DE MOSELEY (SQRT(NU) VS Z)
// ============================================================
let currentMoseleySeries = 'Ka';

function drawFig3() {
  const showAnomalies = document.getElementById('chk_highlight_anomalies').checked;
  const showMissing = document.getElementById('chk_show_missing').checked;
  const isKa = (currentMoseleySeries === 'Ka');

  const xData = [], yData = [], textData = [];
  const anomX = [], anomY = [], anomText = [];

  MOSELEY_ELEMENTS.forEach(item => {
    const energy = isKa ? item.Ka_keV : item.La_keV;
    if (energy) {
      const nu = (energy * 1000 * PHYS.e) / PHYS.h; // frecuencia en Hz
      const sqrtNu = Math.sqrt(nu) / 1e8; // en unidades de 10^8 s^-1/2
      xData.push(item.Z);
      yData.push(sqrtNu);
      textData.push(`${item.sym} (Z=${item.Z})<br>E = ${energy.toFixed(2)} keV<br>√ν = ${sqrtNu.toFixed(2)} × 10⁸`);

      if (item.isAnomaly && showAnomalies) {
        anomX.push(item.Z);
        anomY.push(sqrtNu);
        anomText.push(`Inversión histórica: ${item.sym} (Z=${item.Z})`);
      }
    }
  });

  // Línea teórica ajustada: sqrt(nu) = a * (Z - b)
  // Para Ka: a = sqrt(3/4 * c * R_inf) / 1e8 ≈ 0.4967, b = 1
  // Para La: a = sqrt(5/36 * c * R_inf) / 1e8 ≈ 0.2137, b = 7.4
  const aConst = isKa ? 0.4967 : 0.2137;
  const bConst = isKa ? 1.0 : 7.4;

  const xLine = [10, 85];
  const yLine = xLine.map(z => aConst * (z - bConst));

  const traces = [
    {
      x: xLine, y: yLine,
      type: 'scatter', mode: 'lines',
      name: `Ajuste teórico de Moseley (b = ${bConst})`,
      line: { color: '#c0392b', width: 2.2 }
    },
    {
      x: xData, y: yData,
      type: 'scatter', mode: 'markers',
      name: `Datos experimentales (${currentMoseleySeries})`,
      marker: { color: '#2980b9', size: 8, line: { color: 'white', width: 1 } },
      text: textData,
      hovertemplate: '%{text}<extra></extra>'
    }
  ];

  if (showAnomalies && anomX.length > 0) {
    traces.push({
      x: anomX, y: anomY,
      type: 'scatter', mode: 'markers',
      name: 'Anomalías de masa resueltas',
      marker: { color: '#d35400', size: 14, symbol: 'circle-open', line: { color: '#d35400', width: 2.5 } },
      text: anomText,
      hovertemplate: '%{text}<extra></extra>'
    });
  }

  if (showMissing) {
    const missX = [], missY = [], missText = [];
    PREDICTED_MISSING.forEach(m => {
      const ePred = isKa ? m.Ka_pred : m.La_pred;
      const nuPred = (ePred * 1000 * PHYS.e) / PHYS.h;
      const sqrtNuPred = Math.sqrt(nuPred) / 1e8;
      missX.push(m.Z);
      missY.push(sqrtNuPred);
      missText.push(`Elemento faltante predicho: ${m.name}<br>Z = ${m.Z}`);
    });
    traces.push({
      x: missX, y: missY,
      type: 'scatter', mode: 'markers',
      name: 'Elementos predichos por Moseley',
      marker: { color: '#8e44ad', size: 11, symbol: 'diamond', line: { color: 'white', width: 1.5 } },
      text: missText,
      hovertemplate: '%{text}<extra></extra>'
    });
  }

  Plotly.react('plot_moseley_line', traces, {
    xaxis: { title: 'Número atómico Z (carga nuclear)', range: [8, 86], zeroline: false },
    yaxis: { title: '√ν (10⁸ s⁻¹/²)', range: [0, isKa ? 42 : 18], zeroline: true, zerolinecolor: '#ddd' },
    margin: { l: 65, r: 25, t: 20, b: 50 },
    legend: { x: 0.02, y: 0.98, bgcolor: 'rgba(255,255,255,0.92)', font: { size: 10.5 } },
    plot_bgcolor: '#fafafa'
  }, { responsive: true, displayModeBar: false });

  document.getElementById('stats_moseley').innerHTML =
    `<span class="stat-item"><span class="lbl">Serie activa:</span> <span class="val">${currentMoseleySeries}</span></span>` +
    `<span class="stat-item"><span class="lbl">Constante b:</span> <span class="val">${bConst}</span></span>` +
    `<span class="stat-item"><span class="lbl">Pendiente a:</span> <span class="val">${aConst.toFixed(4)} × 10⁸</span></span>` +
    `<br><span class="stat-item"><span class="lbl">Ecuación:</span> <span class="val">√ν = ${aConst.toFixed(4)} × 10⁸ · (Z − ${bConst})</span></span>`;
}

// ============================================================
// FIGURA 4: SIMULADOR DE ANÁLISIS XRF
// ============================================================
