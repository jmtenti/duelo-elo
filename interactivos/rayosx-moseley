function drawFig4() {
  const sampleKey = document.getElementById('sel_xrf_sample').value;
  const sample = XRF_SAMPLES[sampleKey];

  const eMin = 1.0, eMax = 30.0;
  const N = 350;
  const eArr = [], iArr = [];

  for (let i = 0; i <= N; i++) {
    const e = eMin + ((eMax - eMin) * i) / N;
    eArr.push(e);
    // Ruido de fondo basal
    let val = 2.0 + Math.exp(-e / 6.0) * 3.0;

    // Sumar picos
    sample.peaks.forEach(pk => {
      const sig = 0.22; // resolución del detector en keV
      val += pk.height * Math.exp(-Math.pow(e - pk.energy, 2) / (2 * sig * sig));
    });
    iArr.push(val);
  }

  const annotations = sample.peaks.map(pk => ({
    x: pk.energy, y: pk.height + 6,
    text: `${pk.label}`,
    showarrow: true, arrowhead: 2,
    ax: 0, ay: -25,
    font: { size: 9.5, color: '#2c3e50', weight: 'bold' }
  }));

  const trace = {
    x: eArr, y: iArr,
    type: 'scatter', mode: 'lines',
    name: `Espectro XRF (${sample.name})`,
    fill: 'tozeroy',
    fillcolor: 'rgba(22, 160, 133, 0.14)',
    line: { color: '#16a085', width: 2.4 }
  };

  Plotly.react('plot_xrf', [trace], {
    xaxis: { title: 'Energía de los rayos X E (keV)', range: [1.5, 28.5], zeroline: false },
    yaxis: { title: 'Cuentas / Intensidad fluorescente', range: [0, 125], zeroline: true, zerolinecolor: '#eee' },
    annotations: annotations,
    margin: { l: 65, r: 25, t: 25, b: 50 },
    showlegend: false,
    plot_bgcolor: '#fafafa'
  }, { responsive: true, displayModeBar: false });

  document.getElementById('stats_xrf').innerHTML =
    `<span class="stat-item"><span class="lbl">Muestra:</span> <span class="val">${sample.name}</span></span>` +
    `<span class="stat-item"><span class="lbl">Picos identificados:</span> <span class="val">${sample.peaks.length}</span></span>` +
    `<br><span class="stat-item"><span class="lbl">Composición deducida:</span> <span class="val" style="color:#16a085;">${sample.composition}</span></span>`;
}

// ============================================================
// EVENT HANDLERS E INICIALIZACIÓN
// ============================================================
function attachHandlers() {
  document.querySelectorAll('#btns_target_mat button').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#btns_target_mat button').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentTargetMat = btn.dataset.mat;
      drawFig1();
    });
  });

  document.getElementById('s_volts_spec').addEventListener('input', drawFig1);

  document.getElementById('sel_elem_levels').addEventListener('change', drawFig2);
  document.getElementById('sel_xray_line').addEventListener('change', drawFig2);

  document.querySelectorAll('#btns_moseley_series button').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#btns_moseley_series button').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentMoseleySeries = btn.dataset.series;
      drawFig3();
    });
  });

  document.getElementById('chk_highlight_anomalies').addEventListener('change', drawFig3);
  document.getElementById('chk_show_missing').addEventListener('change', drawFig3);

  document.getElementById('sel_xrf_sample').addEventListener('change', drawFig4);

  window.addEventListener('resize', () => {
    if (typeof Plotly !== 'undefined') {
      ['plot_xray_spec', 'plot_energy_levels', 'plot_moseley_line', 'plot_xrf'].forEach(id => {
        try { Plotly.Plots.resize(id); } catch (err) {}
      });
    }
  });
}

function initAll() {
  if (typeof Plotly === 'undefined') {
    setTimeout(initAll, 100);
    return;
  }
  drawFig1();
  drawFig2();
  drawFig3();
  drawFig4();
  attachHandlers();
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initAll);
} else {
  initAll();
}
</script>
