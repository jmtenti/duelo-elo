    if (hasKa) {
      const sig = 0.0018; // ancho del pico
      const gKa = 85.0 * Math.exp(-Math.pow(lam - mat.Ka_nm, 2) / (2 * sig * sig));
      const gKb = 20.0 * Math.exp(-Math.pow(lam - mat.Kb_nm, 2) / (2 * sig * sig));
