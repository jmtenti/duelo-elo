      { elem: 'Ag', Z: 47, energy: 22.16, height: 25,  label: 'Ag Kα (22.16 keV)' },
      { elem: 'Cu', Z: 29, energy: 8.05,  height: 14,  label: 'Cu Kα (8.05 keV)' }
    ],
    composition: '90% Au, 7% Ag, 3% Cu (oro 21.6k)'
  }
